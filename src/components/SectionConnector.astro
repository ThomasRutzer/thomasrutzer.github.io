---
import Jack from "@components/Jack.astro";
import PatchCable from "@components/patch-cable/PatchCable.astro";

interface Props {
  width?: "sm" | "md" | "lg" | "full";
  direction?: "normal" | "reverse";
  withSpacing?: boolean;
}

const { width = "md", direction = "normal", withSpacing = true } = Astro.props;
---

<div
  class:list={[
    `width-${width}`,
    { reverse: direction === "reverse", spaced: withSpacing },
  ]}
  aria-hidden="true"
>
  <PatchCable mode="tether">
    <Jack data-cable-origin />
    <Jack data-cable-target />
  </PatchCable>
</div>

<style>
  div {
    position: relative;
    height: var(--space-2xl-3xl);
    margin-inline: auto;
    z-index: var(--z-overlay);

    &.spaced {
      margin-block: var(--space-m);
    }

    &.width-sm {
      width: 25%;
    }

    &.width-md {
      width: 50%;
    }

    &.width-lg {
      width: 70%;
    }

    &.width-full {
      width: 100%;
    }

    :global([data-cable-origin]),
    :global([data-cable-target]) {
      position: absolute;
      transform: translate(-50%, -50%);
      z-index: 3;
    }

    :global([data-cable-origin]) {
      top: 0;
      left: 100%;
    }

    :global([data-cable-target]) {
      top: 100%;
      left: 0;
    }

    &.reverse {
      :global([data-cable-origin]) {
        left: 0;
      }

      :global([data-cable-target]) {
        left: 100%;
      }
    }
  }
</style>
