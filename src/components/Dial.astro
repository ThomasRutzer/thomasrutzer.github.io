---
interface Props {
  value: number; // 0–1
  size?: number;
  label?: string;
}

const { value, size = 80, label } = Astro.props;

const START = -135; // degrees from 12 o'clock, clockwise (~7 o'clock)
const SWEEP = 270;

const clamped = Math.max(0, Math.min(1, value));
const angle = START + clamped * SWEEP;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  style={`--angle: ${angle}deg; --start: ${START}deg`}
>
  <circle cx="50" cy="50" r="46"></circle>
  <g>
    <line x1="50" y1="44" x2="50" y2="20"></line>
    <circle cx="50" cy="82" r="3.5"></circle>
  </g>
</svg>

<style>
  svg {
    display: block;
    max-width: 100%;
    height: auto;
    aspect-ratio: 1;

    & > circle {
      stroke: var(--color-ui);
      stroke-width: 2;
    }

    & g {
      rotate: var(--angle);
      transform-origin: 50px 50px;
      animation: dial-sweep 3s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    & g circle {
      fill: var(--color-ui);
    }

    & line {
      stroke: var(--color-y100);
      stroke-width: 6;
      stroke-linecap: round;
    }
  }

  @keyframes dial-sweep {
    from {
      rotate: var(--start);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    svg g {
      animation: none;
    }
  }
</style>
