---
interface Props {
  name?: string;
  rev?: string;
  class?: string;
}

const { name, rev, class: className } = Astro.props;
const hasHeader = Boolean(name || rev || Astro.slots.has("header"));
---

<section class:list={["panel", className]} aria-label={name}>
  <div class="panel-content">
    {
      hasHeader && (
        <header class="panel-header">
          {name && <span class="panel-name">{name}</span>}
          {rev && <span class="panel-rev">{rev}</span>}
          <slot name="header" />
        </header>
      )
    }

    <div class="panel-body">
      <slot />
    </div>
  </div>
</section>

<style>
  .panel {
    --panel-top: var(--color-muted);
    --panel-bottom: color-mix(
      in srgb,
      var(--color-muted) 75%,
      var(--color-foreground)
    );
    --panel-frame: color-mix(
      in srgb,
      var(--color-muted) 55%,
      var(--color-foreground)
    );
    --panel-gap: var(--color-foreground);
    --panel-well: color-mix(
      in srgb,
      var(--color-foreground) 80%,
      var(--color-muted)
    );
    --panel-highlight: color-mix(in srgb, var(--color-p100) 10%, transparent);
    --panel-inset: var(--space-xs);
    --panel-inner-radius: 8px;
    /* outer radius = inner radius + inset, keeps the corners concentric */
    --panel-radius: calc(var(--panel-inner-radius) + var(--panel-inset));

    position: relative;
    overflow: hidden;
    border-radius: var(--panel-radius);
    background: linear-gradient(
      180deg,
      var(--panel-top) 0%,
      var(--panel-bottom) 100%
    );
    margin: 0 calc(var(--space-m) * -1);

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: url("/noise.png") 0 0 / 128px 128px;
      image-rendering: pixelated;
      mix-blend-mode: soft-light;
      opacity: 0.25;
    }

    &::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      background: radial-gradient(
        ellipse 70% 30% at 40% 0%,
        color-mix(in srgb, var(--color-p100) 8%, transparent) 0%,
        transparent 70%
      );
    }
  }

  .panel-content {
    position: relative;
    z-index: 3;
    margin: var(--panel-inset);
    border-radius: var(--panel-inner-radius);
    background: var(--panel-well);
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 var(--space-m);
    padding: var(--space-s) 0;
    border-bottom: var(--border-stroke-width) solid var(--color-muted);
  }

  .panel-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding: var(--space-s);
  }

  .panel-name,
  .panel-rev {
    font-family: var(--font-main);
    font-size: var(--font-step-1);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .panel-name {
    color: var(--color-ui);
  }

  .panel-rev {
    color: color-mix(in srgb, var(--color-ui) 45%, transparent);
  }
</style>
