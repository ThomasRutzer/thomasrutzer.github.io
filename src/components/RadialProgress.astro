---
import Dial from "./Dial.astro";

interface Props {
  progress: number; // 0–100
  label: string;
  value: string;
  size?: number;
}

const { progress, label, value, size = 80 } = Astro.props;
---

<figure>
  <Dial value={progress / 100} {size} />
  <figcaption>
    <span class="value">{value}</span>
    <span class="label">{label}</span>
  </figcaption>
</figure>

<style>
  figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin: 0;
    flex: 1;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3xs);
    color: var(--color-ui);
  }

  .value {
    font-family: var(--font-main);
    font-size: var(--font-step-1);
  }

  .label {
    font-family: var(--font-main);
    font-size: var(--font-step-0);
    max-width: 100%;
    text-wrap: balance;
  }
</style>
