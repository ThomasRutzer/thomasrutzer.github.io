---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"span"> {}

const { class: className, ...rest } = Astro.props;
---

<span class={className} {...rest}></span>

<style>
  span {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: var(--border-stroke-width) solid var(--color-foreground);
    background: var(--color-bg);
  }
</style>
