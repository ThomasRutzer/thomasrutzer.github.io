---
import CaseIcon from "@components/CaseIcon.astro";
import CaseDeco from "@components/CaseDeco.astro";
import Jack from "@components/Jack.astro";
import PatchCable from "@components/patch-cable/PatchCable.astro";
import Panel from "@components/Panel.astro";
import type { CollectionEntry } from "astro:content";
import RadialProgress from "./RadialProgress.astro";
import TechHighlights from "./TechHighlights.astro";
import CaseDuration from "./CaseDuration.astro";
import CaseBy from "./CaseBy.astro";

interface Props {
  cases: CollectionEntry<"cases">[];
}

const { cases } = Astro.props;
---

<div>
  <PatchCable mode="select" active={0}>
    <div role="tablist" aria-label="Case studies">
      {
        cases.map((c, i) => (
          <button
            role="tab"
            id={`tab-${c.id}`}
            aria-controls={`panel-${c.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
          >
            <header>
              <CaseIcon icon={c.data.icon} animate={i === 0} />
              <h2>{c.data.title}</h2>
            </header>

            <footer aria-hidden="true">
              <Jack data-cable-target />
              <span>Out</span>
            </footer>
          </button>
        ))
      }
    </div>

    <div data-input aria-hidden="true">
      <Jack data-cable-origin />
    </div>

    {
      cases.map((c, i) => (
        <section
          role="tabpanel"
          id={`panel-${c.id}`}
          aria-labelledby={`tab-${c.id}`}
          hidden={i !== 0}
        >
          <Panel>
            <header slot="header">
              <CaseBy by={c.data.by} />
              <CaseDuration
                startDate={c.data.startDate}
                endDate={c.data.endDate}
              />
            </header>

            <article>
              <h3>{c.data.title}</h3>

              {c.data.businessCase && (
                <aside>
                  {c.data.businessCase.map((m) => (
                    <RadialProgress
                      label={m.label}
                      value={m.value}
                      progress={m.progress}
                    />
                  ))}
                </aside>
              )}

              {c.data.tech && c.data.tech.length > 0 && (
                <div>
                  <TechHighlights tech={c.data.tech} />
                </div>
              )}

              <p>{c.data.description}</p>
            </article>

            <footer aria-hidden="true">
              <CaseDeco icon={c.data.icon} />
            </footer>
          </Panel>
        </section>
      ))
    }
  </PatchCable>
</div>

<style>
  div:has(> :global(patch-cable)) {
    container-type: inline-size;
    container-name: tablist;
  }

  [role="tablist"] {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

    @container tablist (min-width: 900px) {
      gap: var(--space-m);
    }
  }

  button[role="tab"] {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-xs);
    padding: var(--space-m);
    background: var(--color-panel);
    border: var(--border-stroke-width) solid var(--color-muted);
    border-right: none;
    text-align: left;
    cursor: pointer;

    @container tablist (min-width: 900px) {
      border-radius: var(--border-radius-s);
      border-right: 1px solid var(--color-muted);
    }

    [role="tablist"]:has(:active) & {
      border-right: var(--border-stroke-width) solid var(--color-muted);
    }

    &:first-child {
      @container tablist (max-width: 899px) {
        border-radius: var(--border-radius-s) 0 0 var(--border-radius-s);
      }
    }

    &:last-child {
      border-right: 1px solid var(--color-muted);

      @container tablist (max-width: 899px) {
        border-radius: 0 var(--border-radius-s) var(--border-radius-s) 0;
      }
    }

    header {
      display: flex;
      flex-direction: row;
      gap: var(--space-xs);
      color: var(--color-foreground);
      align-items: flex-start;

      @container tablist (min-width: 900px) {
        flex-direction: row;
        align-items: center;
      }
    }

    h2 {
      font-family: var(--font-main);
      font-size: var(--font-step-1);
      color: var(--color-foreground);
    }

    footer {
      display: flex;
      flex-direction: column;
      align-items: center;
      position: absolute;
      left: 50%;
      bottom: -10px;
      transform: translateX(-50%) translateY(50%);
      font-size: var(--font-step-0);
      color: var(--color-muted);
      text-transform: uppercase;
    }

    footer :global([data-cable-target]) {
      transition:
        border-color 120ms ease,
        box-shadow 120ms ease;
    }

    &[aria-selected="true"] footer :global([data-cable-target]) {
      border-color: var(--color-p100);
      background: var(--color-p100);
    }

    footer :global([data-cable-target][data-cable-hot]) {
      border-color: var(--color-y100);
      box-shadow: 0 0 0 4px
        color-mix(in srgb, var(--color-y100) 30%, transparent);
    }

    &[aria-selected="true"] footer :global([data-cable-target][data-cable-hot]) {
      border-color: var(--color-p300);
      box-shadow: 0 0 0 4px
        color-mix(in srgb, var(--color-p100) 30%, transparent);
    }
  }

  div[data-input] {
    position: relative;
    margin-top: var(--space-2xl-3xl);
    padding-left: 50%;
    z-index: var(--z-dropdown);
  }

  section[role="tabpanel"] {
    margin-top: -7px;

    &[hidden] {
      display: none;
    }

    header {
      display: flex;
      flex: 1;
      justify-content: space-between;
    }

    article {
      display: grid;
      grid-template-areas:
        "title"
        "desc"
        "team"
        "metrics"
        "highlights";
      column-gap: var(--space-xl);
      row-gap: var(--space-m);

      @container tablist (min-width: 900px) {
        grid-template-columns: 1fr 1fr;
        grid-template-areas:
          "title title"
          "desc metrics"
          "team metrics"
          "highlights highlights";
        column-gap: var(--space-2xl);
        row-gap: var(--space-l);
      }
    }

    h3 {
      grid-area: title;
      font-family: var(--font-title);
      font-size: var(--font-step-3);
      line-height: var(--font-step-3-line-height);
      color: var(--color-p100);
      max-width: 16ch;

      &::first-line {
        color: var(--color-ui);
      }
    }

    p {
      grid-area: desc;
      display: flex;
      flex-direction: column;
      gap: var(--space-m);
      text-indent: var(--copy-text-indent);
    }

    article > div {
      grid-area: highlights;
      display: flex;
      flex-direction: column;
      gap: var(--space-m);
      padding-top: var(--space-m);
      border-top: var(--border-stroke-width) solid var(--color-muted);
    }

    aside {
      grid-area: metrics;
      display: flex;
      gap: var(--space-m);
      justify-content: center;
      text-align: center;

      @container tablist (min-width: 900px) {
        gap: var(--space-l);
      }

      figure:nth-child(even) {
        margin-top: calc(var(--space-m) * -1);
      }
    }

    footer {
      display: flex;
      justify-content: center;
    }
  }
</style>

<script>
  import { bindHoverFocusSFX } from "@lib/sfx";
  import type { PatchCableElement } from "@components/patch-cable/patch-cable";
  import "@components/patch-cable/patch-cable";

  function setIconAnimating(tab: HTMLElement, animate: boolean) {
    const icon = tab.querySelector(".case-icon");
    icon?.dispatchEvent(
      new CustomEvent("caseicon:toggle", { detail: { animate } }),
    );
  }

  function initTabs(tablist: HTMLElement) {
    const cable = tablist.closest<PatchCableElement>("patch-cable");
    if (!cable) return;

    const tabs = Array.from(
      tablist.querySelectorAll<HTMLElement>("[role=tab]"),
    );
    let current = cable.activeIndex;

    function activate(index: number, focus: boolean) {
      tabs.forEach((t, i) => {
        t.setAttribute("aria-selected", i === index ? "true" : "false");
        t.setAttribute("tabindex", i === index ? "0" : "-1");
        const panel = document.getElementById(
          t.getAttribute("aria-controls") ?? "",
        );
        if (panel) panel.hidden = i !== index;
      });

      if (index !== current) {
        setIconAnimating(tabs[current], false);
        setIconAnimating(tabs[index], true);
      }

      current = index;
      if (focus) tabs[index].focus();
    }

    cable.addEventListener("cable:connect", (e) => {
      activate(e.detail.index, e.detail.source !== "drag");
    });

    function select(tab: HTMLElement) {
      const index = tabs.indexOf(tab);
      if (index < 0 || index === cable!.activeIndex) return;
      cable!.connectTo(index, { spark: true });
    }

    bindHoverFocusSFX(tabs, {
      skip: (tab) =>
        cable.dragging || tab.getAttribute("aria-selected") === "true",
    });

    tabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => select(tab));

      tab.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") {
          e.preventDefault();
          select(tabs[(idx + 1) % tabs.length]);
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          select(tabs[(idx - 1 + tabs.length) % tabs.length]);
        } else if (e.key === "Home") {
          e.preventDefault();
          select(tabs[0]);
        } else if (e.key === "End") {
          e.preventDefault();
          select(tabs[tabs.length - 1]);
        }
      });
    });
  }

  document
    .querySelectorAll<HTMLElement>("[role=tablist]")
    .forEach(initTabs);
</script>
